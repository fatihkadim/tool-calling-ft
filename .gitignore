# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments and caches
.venv/
.pytest_cache/
.ruff_cache/
*.log

# Data & model artifacts (large, don't commit)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
checkpoints/
outputs/
*.safetensors
*.bin
wandb/
mlruns/

# Env / secrets
.env*
*.env

# Reports (keep benchmark JSONs, markdown reports and figures)
reports/*
!reports/.gitkeep
!reports/*.json
!reports/*.md
!reports/figures/
!reports/figures/*

1.md
SPRINT_PLAN.md